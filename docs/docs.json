      "github": "https://github.com/mahimailabs/livekit-plugins-voicemem",
      "discord": "https://discord.gg/wkCqPMnUw",
      "website": "https://mahimai.ca"
    },
    "links": [
      {
        "header": "Project",
        "items": [
          { "label": "GitHub", "href": "https://github.com/mahimailabs/livekit-plugins-voicemem" },
          { "label": "PyPI", "href": "https://pypi.org/project/livekit-plugins-voicemem/" },
          { "label": "Changelog", "href": "https://github.com/mahimailabs/livekit-plugins-voicemem/blob/main/CHANGELOG.md" }
