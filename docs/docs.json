{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "VoiceMemory",
  "description": "Long-term memory for LiveKit voice agents, backed by PostgreSQL and pgvector.",

  "colors": {
    "primary": "#0E8FA8",
    "light": "#22D3EE",
    "dark": "#0B0D10"
  },

  "appearance": {
    "default": "dark",
    "strict": false
  },

  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#0B0D10"
    },
    "decoration": "gradient"
  },

  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": "dark"
  },

  "favicon": {
    "light": "/assets/favicon.png",
    "dark": "/assets/favicon.png"
  },

  "logo": {
    "light": "/assets/logo-light.png",
    "dark": "/assets/logo-dark.png",
    "href": "https://github.com/mahimailabs/livekit-plugins-voicemem"
  },

  "navigation": {
    "groups": [
      {
        "group": "Get started",
        "icon": "rocket",
        "pages": ["introduction", "quickstart"]
      },
      {
        "group": "API",
        "icon": "code",
        "pages": ["reference"]
      }
    ]
  },

  "navbar": {
    "links": [
      { "label": "Discord", "icon": "discord", "href": "https://discord.gg/wkCqPMnUw" },
      { "label": "PyPI", "icon": "python", "href": "https://pypi.org/project/livekit-plugins-voicemem/" },
      { "label": "Mahimai", "icon": "globe", "href": "https://mahimai.ca" }
    ],
    "primary": {
      "type": "github",
      "href": "https://github.com/mahimailabs/livekit-plugins-voicemem"
    }
  },

  "footer": {
